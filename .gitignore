# BoneCode .gitignore
#
# 目标：仓库里只留源码、文档和可复现的构建脚本。
# 被忽略的都是生成物或本机私有文件，不影响 ./build.sh 构建与运行。
#
# 注意：.gitignore 的注释只能独占一行。
# 模式后面写 "# 说明" 会被当成模式的一部分，那条规则会直接失效。

# ---------------------------------------------------------------------------
# 构建产物
# ---------------------------------------------------------------------------

# SwiftPM 的中间产物与缓存
.build/
.swiftpm/

# build.sh 的产出（.app / .icns / 打包临时目录）
dist/

# tools/make-dmg.sh 的产出
*.dmg

*.app
*.dSYM/
*.o
*.a
*.swiftmodule
*.swiftdoc

# SwiftPM 目前没有第三方依赖，所以 Package.resolved 不会生成。
# 以后若引入依赖，请把它提交进仓库（可执行程序需要锁定版本以保证可复现），
# 因此这里故意不忽略它。

# ---------------------------------------------------------------------------
# 敏感信息 —— 这些绝不能进开源仓库
# ---------------------------------------------------------------------------

# 本地环境变量（接口地址、密钥、令牌）
.env
.env.*
!.env.example

# 证书与签名材料
*.pem
*.key
*.p12
*.pfx
*.cer
*.cert
*.crt
*.der
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# 凭据与令牌文件
credentials.json
secrets.json
secrets.plist
.netrc
.npmrc
.pypirc

# 本机私有配置。应用把设置存在 UserDefaults、把 API Key 存在钥匙串，
# 仓库里不应出现任何形式的明文密钥；这几个名字留给本地开发覆盖用。
Secrets.swift
LocalSecrets.swift
LocalConfig.swift
*.local.swift
*.local.json
*.local.plist

# ---------------------------------------------------------------------------
# 本机 / 个人文件
# ---------------------------------------------------------------------------

# 个人笔记与草稿，不属于产品代码
notes/
scratch/
playground/
TODO.local.md
*.local.md

# 崩溃与诊断日志
*.log
*.crash
*.ips
*.spin

# ---------------------------------------------------------------------------
# macOS 系统文件
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.AppleDouble
.LSOverride
__MACOSX/

# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------

# 个人偏好不共享；若要共享某份配置，用 git add -f 单独加进来。
.vscode/
.idea/
*.iml
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout

# 本项目用 SwiftPM + build.sh 构建，不生成 .xcodeproj。
# 如果临时用 Xcode 打开过，别把工程文件提交进去。
*.xcodeproj
*.xcworkspace

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
*.bak
*.orig
*.rej
*.swp
*~
